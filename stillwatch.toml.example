# stillwatch — example configuration
#
# Copy this to stillwatch.toml and edit. Everything here has a sensible default
# except job names, so a minimal working config is four lines:
#
#     [[job]]
#     name = "nightly-sync"
#       [job.alive]
#       expect_every = "60s"
#
# Run it with:
#     stillwatch --config stillwatch.toml
#
# The config path also comes from $STILLWATCH_CONFIG, and falls back to
# ./stillwatch.toml.


# Where the heartbeat receiver listens. Defaults to 127.0.0.1:9111.
listen = "127.0.0.1:9111"


# ---------------------------------------------------------------------------
# Notification
# ---------------------------------------------------------------------------
#
# ${VAR} is expanded from the environment in any value in this file, so no
# secret ever has to sit on disk. A ${VAR} that is not set is a startup error
# naming the variable — never an empty string that fails quietly later.
#
# For containers, any of these three values can also be set directly:
#
#     STILLWATCH_LISTEN
#     STILLWATCH_NOTIFY_TELEGRAM_TOKEN
#     STILLWATCH_NOTIFY_TELEGRAM_CHAT_ID
#
# The rule is: uppercase the dotted path and replace "." with "_". An
# environment override wins over both the file and any ${VAR} in it. Per-job
# values are deliberately not overridable this way — array entries have no
# stable key to name them by.
#
# Leave this section out entirely and stillwatch still runs; it says so at
# startup and writes alerts to the log instead of delivering them.

[notify.telegram]
token   = "${TELEGRAM_TOKEN}"
chat_id = "${TELEGRAM_CHAT}"


# ---------------------------------------------------------------------------
# A continuously-running job
# ---------------------------------------------------------------------------
#
# The job reports in with a bare POST, from any language, with no client
# library and no dependency:
#
#     curl -fsS -X POST localhost:9111/beat/product-scraper
#
# A body is optional. `worked`, `data_ts` and `counters` are accepted and
# logged today, and are what later versions will evaluate:
#
#     curl -fsS -X POST localhost:9111/beat/product-scraper \
#       -H 'content-type: application/json' \
#       -d '{"worked":true,"counters":{"fetched":120,"parsed":118}}'

[[job]]
name = "product-scraper"

  [job.alive]
  # How often the loop is expected to say it ran.
  expect_every   = "60s"

  # Silence longer than warn_after is a warning; longer than critical_after is
  # critical. Both are optional and default to 5x and 15x expect_every, which
  # is exactly the 60s / 5m / 15m below. warn_after must be longer than
  # expect_every, or it would fire in the ordinary gap between two beats.
  warn_after     = "5m"
  critical_after = "15m"


# ---------------------------------------------------------------------------
# A job that is quiet by design
# ---------------------------------------------------------------------------
#
# No [job.alive] block, so this job is never judged late. A nightly sync that
# legitimately does nothing for twenty-three hours is healthy, and a job that
# never declared a cadence does not inherit one. Its beats are still recorded,
# and a beat for a name that is not configured here is refused with a 404 and
# logged — a typo in the URL must not leave the real job silently unwatched.

[[job]]
name = "nightly-sync"


# ---------------------------------------------------------------------------
# A dependency, probed directly
# ---------------------------------------------------------------------------
#
# Checks are polled by stillwatch rather than reporting in. Latency goes into a
# rolling window and is judged against the dependency's *own* recent normal — a
# dependency that has always taken 400ms is fine; one that took 90ms an hour ago
# is not.

[[check]]
name     = "vendor-api"
type     = "http"                            # or "jsonrpc", which also needs `method`
url      = "https://api.vendor.com/health"
interval = "30s"
timeout  = "3s"                              # must be shorter than interval

# How long every probe must have been failing before the check is called down.
# Defaults to two intervals, so one blip is not a page. This is a duration the
# failures must actually last, not just a window they happen to be alone in.
down_after = "60s"

  [check.degradation]
  # Latency is compared at p90. "Current" is the last twenty probes; the
  # baseline is the window before that, deliberately excluding the recent
  # stretch so a slowdown still in progress cannot teach the baseline that it
  # is normal.
  baseline_window   = "1h"
  warn_multiple     = 3.0                    # p90 three times its own recent normal
  critical_multiple = 8.0

  # Latency that is unacceptable no matter what the baseline has learned.
  #
  # Read this one carefully, because it is doing more work than it looks like.
  # If stillwatch starts while this dependency is already slow, the baseline
  # learns that slow is normal and the multiples will never fire again. The
  # ceiling is evaluated independently of the baseline — and before any baseline
  # exists at all — so it is the only thing that catches that case. Set it to
  # what you actually consider unacceptable, not to some extreme: a baseline
  # poisoned to a value *below* the ceiling is still invisible.
  #
  # stillwatch also alerts if the baseline itself ends up at or above this
  # value, because that means the check has stopped protecting you.
  absolute_ceiling  = "2s"

  # Probes needed before the baseline is trusted. Until then the check reports
  # "warming up" rather than "ok" — not being judged yet is not the same as
  # being healthy — and only the ceiling applies. Startup logs say how long the
  # wait will be. A baseline_window too short to ever hold this many probes at
  # this interval is rejected at startup rather than warming up forever.
  min_samples       = 30

# A check with no [check.degradation] block is watched for up/down only and is
# never judged on latency, however slow it gets.
#
# [[check]]
# name = "queue-broker"
# url  = "https://broker.internal/ping"


# ---------------------------------------------------------------------------
# Not yet implemented
# ---------------------------------------------------------------------------
#
# This version evaluates the `alive` signal and dependency checks. Config for
# anything else — [job.worked], [job.freshness], [[job.ratio]] — parses without
# error but is not acted on, and stillwatch logs a warning at startup naming
# each key it is ignoring, so a line that does nothing never does so quietly.
